---
controller_roles:
  - user: {{ _tenant_dispatcher_defaults.launcher_user | to_json }}
    job_template: {{ (_effective_dispatcher_job_template ~ '-' ~ _dispatcher_target_env) | to_json }}
    lookup_organization: Default
    role: execute
    state: present
  # AWX named URL: only '+' is substituted as '[+]' inside a component.
  # Other reserved characters (;/?:@=&[]) are percent-encoded by the Controller
  # API client. Some AAP ingress layers reject %2F in paths, so brownfield
  # Organization names containing '/' remain a platform compatibility gap for
  # org-qualified Team Execute grants — not invalid customer naming.
  - team: {{ ((_effective_team_name | replace('+', '[+]')) ~ '++' ~ (_effective_aap_organization | replace('+', '[+]'))) | to_json }}
    job_template: {{ (_effective_dispatcher_job_template ~ '-' ~ _dispatcher_target_env) | to_json }}
    lookup_organization: Default
    role: execute
    state: present
